# Optional. Neon (or any Postgres) URL so news edits persist on Vercel.
# Without it, the public site still serves the LinkedIn catalogue.
DATABASE_URL=

# Optional. Better Auth secret for the news-desk sign-in.
BETTER_AUTH_SECRET=

# Optional. Comma-separated editor emails for the news desk.
# When unset, only @itb.ac.id (and *.itb.ac.id) accounts can publish.
# Set both so the server and the browser UI agree for non-ITB editors.
EDITOR_EMAILS=
VITE_EDITOR_EMAILS=
